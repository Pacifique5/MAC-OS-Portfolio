# Call booking (Calendar app). Copy to .env.local for local testing, or add in Vercel → Settings → Environment Variables.
# Local development works without any of these (in-memory bookings, email printed to the console).

# Upstash Redis: added automatically when you connect Upstash to the project in Vercel.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Resend API key (https://resend.com). Sign up with the address that should receive bookings.
RESEND_API_KEY=

# Optional
# BOOKING_EMAIL_TO=Pacifiquem58@gmail.com
# Needs a domain verified in Resend; the default onboarding@resend.dev only delivers to your Resend account email.
# BOOKING_EMAIL_FROM=Portfolio Bookings <bookings@yourdomain.com>
